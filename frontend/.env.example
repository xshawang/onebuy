# ========================================
# OneClick Admin - 环境变量模板
# 拷贝为 .env / .env.development / .env.production 后按需修改
# ========================================

# 应用部署的访问路径前缀（Base Path）
# 部署到域名根：VITE_BASE_PATH=/
# 部署到子路径：VITE_BASE_PATH=/admin/
# 注意：必须以 / 开头，以 / 结尾
VITE_BASE_PATH=/

# 开发服务器端口（可选，默认 5175）
VITE_DEV_PORT=5175

# 应用标题（预留，可在 index.html 中读取）
VITE_APP_TITLE=OneClick Admin
